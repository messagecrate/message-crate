{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src"],
  // Tests are a separate program (tsconfig.test.json). Keeping them out of
  // this one is what stops a browser-only component from type-checking
  // against Node's ambient globals — `process`, `Buffer`, `__dirname` —
  // which enter the moment any file in the program pulls in @types/node.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
