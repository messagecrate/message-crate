// No timed waits in web/src test files or test helpers (#2902). web/biome.json
// runs it on them; Biome reports each name it matches as an error at its file
// and line. The rule and its reasons: web/src/test/README.md, "The check".
// src/test/noTimedWaitsInTests.canary.ts holds every form, so a form this
// stops matching fails the lint.
//
// It matches a name wherever it appears, not only where it is called, so an
// import, an alias (`waitFor as wf`), a typed call (`findByRole<T>()`), an
// optional call (`screen.findByText?.()`) and a reference passed on
// (`const t = window.setTimeout`) are all caught. A string such as
// `toFake: ["setTimeout"]` is not a name, so it passes.
language js

or {
  r"^(?:waitFor|waitUntil|waitForElementToBeRemoved|find(?:All)?By(?:Role|LabelText|PlaceholderText|Text|DisplayValue|AltText|Title|TestId))$" as $name where {
    register_diagnostic(span=$name, message="This polls until a timeout, so the test depends on time. Tell the test when the state is reached and read it with getBy or queryBy: web/src/test/README.md, section 'Each kind of wait and how the test is told'.", severity="error")
  },
  `expect.poll` as $poll where {
    register_diagnostic(span=$poll, message="This polls until a timeout, so the test depends on time. Tell the test when the state is reached and read it with getBy or queryBy: web/src/test/README.md, section 'Each kind of wait and how the test is told'.", severity="error")
  },
  r"^(?:setTimeout|setInterval|setImmediate|requestAnimationFrame)$" as $timer where {
    register_diagnostic(span=$timer, message="A real timer waits on real time. Use settle(), advanceTimersAndSettle() or advanceToNextFrame() on the fake clock: web/src/test/README.md, section 'A real sleep in the test'. A timer the test needs on purpose opts out with a biome-ignore comment that gives its reason.", severity="error")
  },
  r"^[\"'](?:node:)?timers/promises[\"']$" as $module where {
    register_diagnostic(span=$module, message="A real timer waits on real time. Use settle(), advanceTimersAndSettle() or advanceToNextFrame() on the fake clock: web/src/test/README.md, section 'A real sleep in the test'.", severity="error")
  }
}
