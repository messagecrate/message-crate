{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!!**/dist", "!package-lock.json", "!src/lib/serverApi.types.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error",
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use Button or PlainButton from src/components, which are React Aria's Button (STYLE_GUIDE.md, rule 4)."
            }
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tanstack/react-query": {
                "importNames": ["useMutation", "MutationObserver", "*"],
                "message": "Write account data with useRouteMutation from src/lib/routeQuery.ts, which marks the account's cache stale once the write settles (docs/adr/0002-one-way-to-fetch-data-in-the-web-app.md)."
              },
              "@tauri-apps/api/core": "Call the desktop through src/lib/tauri.ts",
              "@tauri-apps/api/event": "Call the desktop through src/lib/tauri.ts",
              "@tauri-apps/api/window": "Call the desktop through src/lib/tauri.ts",
              "@tauri-apps/plugin-dialog": "Call the desktop through src/lib/tauri.ts",
              "@testing-library/user-event": "Use setupUser() and fill() from src/test/user.ts, which say why a test's user fires events without a delay (#1653).",
              "react-aria-components": {
                "importNames": ["Tab"],
                "message": "Use Tab from src/components/Tab.tsx, the one tab style (STYLE_GUIDE.md, rule 4)."
              }
            }
          }
        },
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowConstantExport": true,
            "allowExportNames": [
              "ATTACHMENT_OPTIONS",
              "ListBoxItem",
              "RESOLUTION_OPTIONS",
              "bubbleBody",
              "completionTextFor",
              "formatCompare",
              "formatMessageTime",
              "hintClass",
              "mockedAuth",
              "namesSender",
              "renderWithProviders",
              "sectionGapClass",
              "selectItemClassName",
              "senderName",
              "tapbackGroups",
              "testQueryClient",
              "useAuth",
              "useTheme"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/test/user.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/tauri.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/Tab.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tanstack/react-query": {
                    "importNames": ["useMutation", "MutationObserver", "*"],
                    "message": "Write account data with useRouteMutation from src/lib/routeQuery.ts, which marks the account's cache stale once the write settles (docs/adr/0002-one-way-to-fetch-data-in-the-web-app.md)."
                  },
                  "@tauri-apps/api/core": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/api/event": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/api/window": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/plugin-dialog": "Call the desktop through src/lib/tauri.ts",
                  "@testing-library/user-event": "Use setupUser() and fill() from src/test/user.ts, which say why a test's user fires events without a delay (#1653)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/routeQuery.ts",
        "src/components/DownloadAttachmentButton.tsx",
        "src/hooks/useStreamedMedia.ts",
        "src/lib/useToolsStatus.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tauri-apps/api/core": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/api/event": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/api/window": "Call the desktop through src/lib/tauri.ts",
                  "@tauri-apps/plugin-dialog": "Call the desktop through src/lib/tauri.ts",
                  "@testing-library/user-event": "Use setupUser() and fill() from src/test/user.ts, which say why a test's user fires events without a delay (#1653).",
                  "react-aria-components": {
                    "importNames": ["Tab"],
                    "message": "Use Tab from src/components/Tab.tsx, the one tab style (STYLE_GUIDE.md, rule 4)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": "off"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
